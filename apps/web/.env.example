# Supabase (obligatorio para auth y datos)
# Copia a .env.local y rellena con los valores de tu proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE=eyJ...
# Alternativamente puede usarse SUPABASE_SERVICE_ROLE_KEY (mismo valor que SUPABASE_SERVICE_ROLE)

# Opcional
NEXT_PUBLIC_DEFAULT_COMPANY_ID=company-1
